/* LCS700 QSS 模板 token 占位，由 ui/theme.py render_qss 替换；scripts/dev_run.py 可热重载 */

* { font-family: "Segoe UI", "Microsoft YaHei", sans-serif; outline: none; }
QWidget { color: {tx}; font-size: 13px; }
QToolTip { background: {raise}; color: {tx}; border: 1px solid {line}; border-radius: 8px; padding: 4px 8px; }
QMainWindow#AppWindow, QWidget#AppShell { background: {board}; }

/* ── 顶部栏 ─────────────────────────────── */
QFrame#TBar { background: {topbar}; border: none; border-bottom: 1px solid {line}; }
QWidget#RunchLogo { }
/* 顶/底栏可点容器用 QFrame（ClickFrame）：QPushButton sizeHint 忽略内部布局，logo/文字会压塌重叠 */
QFrame#BrandBtn { background: transparent; border: none; border-radius: 10px; padding: 2px 6px; }
QFrame#BrandBtn:hover { background: {glass}; }
QLabel#BrandCn { color: {tx}; font-size: 16px; font-weight: 800; letter-spacing: 1px; }
QLabel#BrandEn { color: {dim}; font-size: 10px; font-weight: 600; letter-spacing: 2px; }
QLabel#PageTitlePill { background: {glass}; color: {mut}; border: 1px solid {line};
  border-radius: 8px; padding: 3px 12px; font-size: 12px; font-weight: 600; }
QLabel#CnPill { background: {glass}; color: {cyan}; border: 1px solid {acc_line};
  border-radius: 8px; padding: 3px 10px; font-size: 11px; font-weight: 600;
  font-family: "JetBrains Mono", "Cascadia Code", Consolas, monospace; }
QLabel#ClockPill { background: {glass}; color: {mut}; border: 1px solid {line};
  border-radius: 8px; padding: 5px 12px; font-size: 12px; font-weight: 700;
  font-family: "JetBrains Mono", "Cascadia Code", Consolas, monospace; }
QPushButton#ThemeBtn { background: {glass}; color: {mut}; border: 1px solid {line};
  border-radius: 18px; padding: 0; font-size: 16px; font-weight: 700;
  min-width: 36px; max-width: 36px; min-height: 36px; max-height: 36px; }
QPushButton#ThemeBtn:hover { color: {acc_hi}; background: {acc_soft}; border-color: {acc_line}; }
QPushButton#ExitBtn { background: {crit_soft}; color: {crit}; border: 1px solid {crit_line};
  border-radius: 8px; padding: 7px 14px; font-size: 12px; font-weight: 700; }
QPushButton#ExitBtn:hover { color: {crit_hi}; background: {crit_soft}; border-color: {crit}; }

/* ── 底部栏 ─────────────────────────────── */
QFrame#BBar { background: {bottomb}; border: none; border-top: 1px solid {line}; }
QFrame#AccountBtn { background: transparent; border: none; border-radius: 10px; padding: 4px 10px; }
QFrame#AccountBtn:hover { background: {glass}; }
QLabel#AvatarLabel { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 {ok_grad0}, stop:1 {ok_grad1});
  color: #FFFFFF; border-radius: 9px; font-size: 11px; font-weight: 800; }
QLabel#AccountName { color: {mut}; font-size: 13px; font-weight: 600; }
QPushButton#bbBtn { background: {glass}; color: {mut}; border: 1px solid {line};
  border-radius: 9px; padding: 7px 16px; font-size: 12px; font-weight: 600; }
QPushButton#bbBtn:hover { color: {acc}; border-color: {acc_line}; }
QPushButton#bbBtn[bb="primary"] { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 {acc_grad0}, stop:1 {acc_grad1});
  color: {acc_ink}; border: none; font-weight: 700; }
QPushButton#bbBtn[bb="primary"]:hover { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 {acc_hi}, stop:1 {acc}); }
QPushButton#bbBtn[bb="primary"]:pressed { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 {acc_grad1}, stop:1 {acc_grad0}); }
QPushButton#bbBtn[bb="primary"]:disabled { background: {line}; color: {dim}; }
QPushButton#bbBtn:disabled { color: {dim}; border-color: {line}; }

/* ── 通用按钮 role ───────────────────────── */
QPushButton[role="primary"] { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 {acc_grad0}, stop:1 {acc_grad1});
  color: {acc_ink}; border: none; border-radius: {radius}; padding: 10px 24px; font-size: 13px; font-weight: 700; }
QPushButton[role="primary"]:hover { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 {acc_hi}, stop:1 {acc}); }
QPushButton[role="primary"]:pressed { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 {acc_grad1}, stop:1 {acc_grad0}); }
QPushButton[role="primary"]:disabled { background: {line}; color: {dim}; }
QPushButton[role="ghost"] { background: transparent; color: {mut}; border: 1px solid {line};
  border-radius: {radius}; padding: 9px 22px; font-size: 13px; }
QPushButton[role="ghost"]:hover { color: {acc}; border-color: {acc}; background: {acc_soft}; }
QPushButton[role="danger"] { background: transparent; color: {crit}; border: 1px solid {crit_line};
  border-radius: {radius}; padding: 9px 22px; font-size: 13px; font-weight: 600; }
QPushButton[role="danger"]:hover { background: {crit_soft}; }
QPushButton[role="mini"] { background: {panel}; color: {mut}; border: 1px solid {line};
  border-radius: 8px; padding: 6px 14px; font-size: 12px; }
QPushButton[role="mini"]:disabled { color: {dim}; background: transparent; opacity: 0.5; }
QPushButton[role="mini"]:hover { color: {acc}; border-color: {acc_line}; background: {acc_soft}; }
QPushButton[role="link"] { background: transparent; color: {acc}; border: none;
  font-size: 12px; padding: 2px 4px; }
QPushButton[role="link"]:hover { text-decoration: underline; }

/* ── 反馈 / 焦点 / 禁用 ────────────────────── */
QPushButton:disabled { color: {dim}; }
QPushButton:focus { border-color: {acc}; }          /* 只给有边框按钮上色，无边框按钮不受影响 */
QLineEdit:focus { background: {acc_soft}; }          /* 输入框聚焦：软底高亮 */

/* ── 毛玻璃卡片 / 通用基元 ────────────────── */
QFrame[role="glass"] { background: {glass}; border: 1px solid {line}; border-radius: {radius}; }
QFrame[card="glass"] { background: {glass}; border: 1px solid {line}; border-radius: {radius}; }
QLabel#SecTitle { color: {mut}; font-size: 12px; font-weight: 700; letter-spacing: 0.5px; }
QLabel#SecCount { color: {dim}; font-family: "JetBrains Mono", Consolas, monospace; font-size: 11px; }
QLabel#SecHint { color: {dim}; font-size: 11px; }
QLabel#StatusDot { border-radius: 4px; }
QLabel#Tag { border-radius: 9px; padding: 2px 10px; font-size: 10px; font-weight: 700; }
QLabel[role="tag"] { border-radius: 9px; padding: 2px 10px; font-size: 10px; font-weight: 700; }
QLabel[role="tag"][kind="ok"] { background: {ok_soft}; color: {ok}; border: 1px solid {ok_line}; }
QLabel[role="tag"][kind="warn"] { background: {warn_soft}; color: {warn}; border: 1px solid {warn_line}; }
QLabel[role="tag"][kind="crit"] { background: {crit_soft}; color: {crit}; border: 1px solid {crit_line}; }
QLabel[role="tag"][kind="acc"] { background: {acc_soft}; color: {acc}; border: 1px solid {acc_line}; }
QLabel[role="tag"][kind="muted"] { background: {glass}; color: {mut}; border: 1px solid {line}; }

/* ── Toast（底栏上方居中） ─────────────────── */
QLabel#Toast { background: {raise}; color: {tx}; border: 1px solid {line}; border-radius: 10px;
  padding: 10px 18px; font-size: 13px; }
QLabel#Toast[kind="ok"] { border-color: {ok_line}; color: {ok}; }
QLabel#Toast[kind="crit"] { border-color: {crit_line}; color: {crit}; }

/* ── 模态对话框 ──────────────────────────── */
QFrame#Modal { background: {board}; border: 1px solid {line}; border-radius: 16px; }
QLabel#ModalTitle { color: {tx}; font-size: 15px; font-weight: 700; }
QLabel#ModalBody { color: {mut}; font-size: 13px; }
QFrame#ModalScrim { background: rgba(0, 0, 0, 0.5); }

/* ── 相控步进器（数字 01-04） ──────────────── */
QFrame#stepsBar { background: transparent; border: none; }
QLabel#StepDot { background: {panel}; color: {dim}; border: 1.5px solid {line};
  border-radius: 13px; font-weight: 700; font-size: 12px;
  font-family: "JetBrains Mono", Consolas, monospace; }
QLabel#StepLabel { color: {mut}; font-size: 12px; font-weight: 600; }
QLabel#StepSub { color: {dim}; font-size: 10px; }
QLabel#StepDot[stepState="done"] { background: {ok}; border-color: {ok}; color: #FFFFFF; }
QLabel#StepLabel[stepState="done"] { color: {ok}; }
QLabel#StepDot[stepState="current"] { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 {acc_grad0}, stop:1 {acc_grad1});
  border-color: transparent; color: {acc_ink}; }
QLabel#StepLabel[stepState="current"] { color: {tx}; font-weight: 700; }
QLabel#StepSub[stepState="current"] { color: {acc}; }
QLabel#Conn { background: {line}; border-radius: 1px; }

/* ── 滚动区 / 滚动条 ──────────────────────── */
QScrollArea { background: transparent; border: none; }
QScrollArea > QWidget > QWidget { background: transparent; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: {line}; border-radius: 5px; min-height: 28px; }
QScrollBar::handle:vertical:hover { background: {dim}; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: {line}; border-radius: 5px; min-width: 28px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }

/* ── 输入条通用 ──────────────────────────── */
QLineEdit#aiText, QLineEdit#remoteId { background: transparent; color: {tx};
  border: none; font-size: 14px; padding: 0; selection-background-color: {acc_soft}; }
QLineEdit#aiText:focus, QLineEdit#remoteId:focus { border: none; }


/* ── 主页 ────────────────────────────────── */
QWidget#page-home { background: {board}; }
QLabel#homeTitle { color: {tx}; font-size: 18px; font-weight: 800; letter-spacing: 1px; }
QLabel#homeTitle[sz="sm"] { font-size: 16px; }
QFrame#secLine { background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
  stop:0 {acc}, stop:1 {cyan}); border-radius: 2px;
  min-width: 40px; max-width: 40px; min-height: 3px; max-height: 3px; }
/* 分区容器限宽居中（设计稿 max-width + margin:0 auto）。Qt 布局中 stretch spacer 会抢走
   弹性空间、宿主停在内容宽不居中，故用 min==max 钉住设计宽度，两侧 spacer 自然居中。 */
QFrame#devGridHost { min-width: 754px; max-width: 754px; }
QFrame#sympHost { min-width: 920px; max-width: 920px; }
QFrame#aiBarHost { min-width: 760px; max-width: 760px; }
QFrame#quickHost { min-width: 645px; max-width: 645px; }
QLabel#homeSub { color: {dim}; font-size: 13px; }
QFrame[card="dev"] { background: {panel}; border: 1px solid {line}; border-radius: 14px;
  padding: 12px 14px 14px; }
QFrame[card="dev"]:hover { border-color: {acc}; background: {raise}; }
QFrame[card="dev"][sel="on"] { background: {acc_soft}; border: 1.5px solid {acc}; }
QLabel#devName { color: {tx}; font-size: 15px; font-weight: 700; }
QFrame[card="dev"][sel="on"] QLabel#devName { color: {acc}; }
QLabel#devSys { color: {mut}; font-size: 12px; }
QLabel#devObd { color: {dim}; font-size: 11px; }

/* 彩色图标小方块（对齐设计稿 .dev-card .pic / .quick-tile .ic）：
   底色语义软底 + 图标描边用对应 *_hi 令牌；尺寸 sz=36（设备卡）/32（快捷宫格）。 */
QFrame#IconBox { border-radius: 10px; }
QFrame#IconBox[sz="36"] { min-width: 36px; max-width: 36px; min-height: 36px; max-height: 36px; }
QFrame#IconBox[sz="32"] { min-width: 32px; max-width: 32px; min-height: 32px; max-height: 32px; }
QFrame#IconBox[ic="acc"] { background: {acc_soft}; }
QFrame#IconBox[ic="warn"] { background: {warn_soft}; }
QFrame#IconBox[ic="ok"] { background: {ok_soft}; }
QFrame#IconBox[ic="purple"] { background: {purple_soft}; }
QPushButton#devDel { background: transparent; color: {dim}; border: none; border-radius: 11px;
  font-size: 13px; min-width: 22px; max-width: 22px; min-height: 22px; max-height: 22px; }
QPushButton#devDel:hover { color: {crit}; background: {crit_soft}; }
QFrame[card="dev-add"] { background: transparent; border: 1.5px dashed {line}; border-radius: {radius}; }
QFrame[card="dev-add"]:hover { border-color: {acc}; }
QLabel#devAddLabel { color: {dim}; font-size: 12px; font-weight: 600; }
QLabel#devAddPlus { color: {dim}; font-size: 26px; }
QFrame#iconPick { background: transparent; border: 1px solid {line}; border-radius: 8px;
  min-width: 46px; max-width: 46px; min-height: 46px; max-height: 46px; }
QFrame#iconPick:hover { border-color: {acc_line}; }
QFrame#iconPick[sel="on"] { border: 2px solid {acc}; }

/* 常见故障现象：两级（对齐设计稿 .symp-cats / .symp-items 胶囊多选）。
   两点 Qt 限制：QPushButton 的 QSS background 不按 border-radius 裁剪（故用 QFrame）；
   radius > 控件半高时整块回退矩形（胶囊高≈31，半高 15.5，radius 13 留安全裕量）。 */
QFrame[role="symp-cat"] { background: {panel}; border: 1px solid {line}; border-radius: 13px;
  padding: 8px 16px; }
QFrame[role="symp-cat"]:hover { border-color: {acc_line}; }
QFrame[role="symp-cat"][sel="on"] { background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
  stop:0 {acc_grad0}, stop:1 {acc_grad1}); border-color: transparent; }
QLabel#sympCatText { color: {mut}; font-size: 13px; font-weight: 600; }
/* 注意：后代选择器配祖先 :hover 在本 Qt 构建下恒命中（quickName/sympCatText 曾全变强调蓝）。
   hover 文字色改用对 label 自身的直接 :hover（label 铺满胶囊内部，悬停胶囊即悬停 label）。 */
QLabel#sympCatText:hover { color: {acc_hi}; }
QFrame[role="symp-cat"][sel="on"] QLabel#sympCatText { color: {acc_ink}; }
QFrame[symp="item"] { background: {panel}; border: 1px solid {line}; border-radius: 10px;
  padding: 9px 14px; }
QFrame[symp="item"]:hover { border-color: {acc_line}; }
QFrame[symp="item"][sel="on"] { border-color: {acc}; background: {acc_soft}; }
QLabel#sympChk { background: transparent; border: 1.5px solid {dim}; border-radius: 4px;
  color: transparent; font-size: 10px; font-weight: 800;
  min-width: 16px; max-width: 16px; min-height: 16px; max-height: 16px; }
QFrame[symp="item"][sel="on"] QLabel#sympChk { background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
  stop:0 {acc_grad0}, stop:1 {acc_grad1}); border-color: transparent; color: {acc_ink}; }
QLabel#sympText { color: {tx}; font-size: 13px; font-weight: 500; }
QFrame[symp="item"][sel="on"] QLabel#sympText { color: {acc}; font-weight: 600; }

/* AI 输入条 */
QFrame[card="ai-bar"] { background: {panel}; border: 1px solid {line};
  border-radius: 14px; padding: 6px 8px 6px 18px; }
QPushButton#attachBtn, QPushButton#voiceBtn { background: transparent; color: {dim};
  border: none; border-radius: 8px; font-size: 15px;
  min-width: 32px; max-width: 32px; min-height: 32px; max-height: 32px; }
QPushButton#attachBtn:hover, QPushButton#voiceBtn:hover { background: {raise}; color: {acc}; }
QPushButton#SendBtn { background: transparent; border: none; }

/* 快捷服务 4 宫格 */
QFrame[card="quick"] { background: {panel}; border: 1px solid {line}; border-radius: 12px;
  padding: 14px 10px; }
QFrame[card="quick"]:hover { border-color: {acc_line}; background: {acc_soft}; }
QLabel#quickName { color: {tx}; font-size: 13px; font-weight: 600; }
QLabel#quickSub { color: {dim}; font-size: 10.5px; }
/* 设计稿 hover 只变边框/底，名色不变；不要用 :hover 后代选择器（本 Qt 构建恒命中） */


/* ── AI 智能诊断页 ───────────────────────── */
QWidget#page-ai-diagn { background: {board}; }
QPushButton#CrumbBack { background: transparent; color: {mut}; border: none;
  padding: 3px 6px; font-size: 13px; font-weight: 600; }
QPushButton#CrumbBack:hover { color: {acc}; }
QLabel#CrumbText { color: {tx}; font-size: 14px; font-weight: 700; }
QLabel#VinTag { background: {glass}; color: {cyan}; border: 1px solid {acc_line};
  border-radius: 8px; padding: 2px 10px; font-size: 11px;
  font-family: "JetBrains Mono", Consolas, monospace; }

/* 远驰AI 诊断过程 */
QFrame#dynCard { background: {glass}; border: 1px solid {line}; border-radius: {radius}; }
QLabel#aiAvatar { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 {acc_grad0}, stop:1 {acc_grad1});
  border-radius: 15px; color: {acc_ink}; font-size: 14px; font-weight: 800; }
QLabel#dynStatus { border-radius: 9px; padding: 3px 12px; font-size: 11px; font-weight: 700; }
QLabel#dynStatus[state="running"] { background: {acc_soft}; color: {acc}; border: 1px solid {acc_line}; }
QLabel#dynStatus[state="thinking"] { background: {warn_soft}; color: {warn}; border: 1px solid {warn_line}; }
QLabel#dynStatus[state="done"] { background: {ok_soft}; color: {ok}; border: 1px solid {ok_line}; }
QLabel#dynStatus[state="error"] { background: {crit_soft}; color: {crit}; border: 1px solid {crit_line}; }
QFrame#dynMsg { background: transparent; border: none; }
QLabel#dynDot { background: {line}; border-radius: 3px; }
QLabel#dynDot[cls="done"] { background: {ok}; }
QLabel#dynDot[cls="thinking"] { background: {warn}; }
QLabel#dynText { color: {mut}; font-size: 12px; }
QFrame#dynMsg[cls="done"] QLabel#dynText { color: {tx}; }
QLabel#dynTs { color: {dim}; font-size: 10px; font-family: "JetBrains Mono", Consolas, monospace; }

/* 当前车辆信息 */
QFrame#vehCard { background: {glass}; border: 1px solid {line}; border-radius: {radius}; }
QLabel#vehKey { color: {dim}; font-size: 11px; }
QLabel#vehVal { color: {tx}; font-size: 12px; font-weight: 600; }
QFrame#dtcRow { background: {glass}; border: 1px solid {line}; border-radius: 9px; }
QLabel#dtcCode { color: {crit}; font-family: "JetBrains Mono", Consolas, monospace; font-size: 13px; font-weight: 700; }
QFrame#dtcRow[st="his"] QLabel#dtcCode { color: {dim}; }
QLabel#dtcDesc { color: {mut}; font-size: 12px; }
QLabel#dtcTag { border-radius: 8px; padding: 2px 9px; font-size: 10px; font-weight: 700; }
QLabel#dtcTag[st="cur"] { background: {crit_soft}; color: {crit}; }
QLabel#dtcTag[st="his"] { background: {glass}; color: {dim}; }

/* AI 诊断结果 */
QFrame#resultCard { background: {glass}; border: 1px solid {line}; border-radius: {radius}; }
QLabel#resultTitle { color: {tx}; font-size: 16px; font-weight: 800; }
QLabel#resultMeta { color: {dim}; font-size: 11px; }
QFrame#causeRow { background: {panel}; border: 1px solid {line}; border-radius: 11px; }
QLabel#causeRank { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 {acc_grad0}, stop:1 {acc_grad1});
  color: {acc_ink}; border-radius: 9px; font-size: 12px; font-weight: 800;
  font-family: "JetBrains Mono", Consolas, monospace; }
QLabel#causeName { color: {tx}; font-size: 14px; font-weight: 700; }
QLabel#causeDesc { color: {mut}; font-size: 12px; }
QLabel#causeProb { border-radius: 9px; padding: 2px 10px; font-size: 11px; font-weight: 800; }
QLabel#causeProb[pl="high"] { background: {crit_soft}; color: {crit}; }
QLabel#causeProb[pl="mid"] { background: {warn_soft}; color: {warn}; }
QLabel#causeProb[pl="low"] { background: {acc_soft}; color: {acc}; }

/* 建议排查步骤 */
QFrame#stepsCard { background: {glass}; border: 1px solid {line}; border-radius: {radius}; }
QPushButton#stepItem { background: transparent; color: {mut}; border: 1px solid transparent;
  border-radius: 10px; padding: 10px 12px; font-size: 13px; text-align: left; }
QPushButton#stepItem:hover { background: {glass}; color: {tx}; }
QPushButton#stepItem[sel="on"] { background: {acc_soft}; border-color: {acc_line}; color: {acc}; font-weight: 600; }
QFrame#stepDetail { background: {panel}; border: 1px solid {line}; border-radius: 11px; }
QLabel#stepTitle { color: {tx}; font-size: 14px; font-weight: 700; }
QLabel#stepK { color: {dim}; font-size: 11px; font-weight: 700; }
QLabel#stepV { color: {mut}; font-size: 12px; }


/* ── 诊断报告 ────────────────────────────── */
QWidget#page-report { background: {board}; }
/* 列表 = 单一玻璃容器（GlassCard role="glass" 已提供底/边框/圆角），
   内部表头+数据行用同一网格，行与行之间细下边框分隔（设计稿 .report-list） */
QFrame#rlHead { background: transparent; border-bottom: 1px solid {line}; }
QLabel#rlHeadCell { color: {mut}; font-size: 12px; font-weight: 700; }
QFrame#rlRow { background: transparent; border-bottom: 1px solid {line}; }
QFrame#rlRow[last="1"] { border-bottom: none; }
QLabel#rlTime { color: {tx}; font-size: 12px; font-family: "JetBrains Mono", Consolas, monospace; }
QLabel#rlDev { color: {tx}; font-size: 13px; font-weight: 600; }
QLabel#rlSummary { color: {mut}; font-size: 13px; }
QPushButton[role="mini"][danger="1"] { color: {crit}; border-color: {crit_line}; }
QPushButton[role="mini"][danger="1"]:hover { color: {crit_hi}; border-color: {crit}; background: {crit_soft}; }
QLabel#rlEmpty { color: {mut}; font-size: 13px; padding: 22px 0; }
QFrame#paper { background: #FFFFFF; border: 1px solid #DDE1E8; border-radius: 10px; }
QFrame#paper QLabel { color: #111827; }
QFrame#paper QLabel#paperH { color: #111827; font-size: 15px; font-weight: 700; }
QFrame#paper QLabel#paperM { color: #4B5563; font-size: 12px; }
QLabel#paperNo { color: #6B7280; font-size: 11px;
  font-family: "JetBrains Mono", Consolas, monospace; }
QLabel#paperSec { color: #1D4ED8; font-size: 13px; font-weight: 700;
  border-left: 3px solid #2563EB; padding-left: 8px; margin-top: 8px; }
QFrame#paperRow { background: transparent; }
QLabel#paperK { color: #6B7280; font-size: 12px; min-width: 96px; }
QLabel#paperV { color: #111827; font-size: 12px; font-weight: 600; }


/* ── 系统设置 ────────────────────────────── */
QWidget#page-settings { background: {board}; }
QFrame[card="set-row"] { background: {glass}; border: 1px solid {line}; border-radius: 11px; }
QLabel#setName { color: {tx}; font-size: 13px; font-weight: 600; }
QLabel#setDesc { color: {dim}; font-size: 11px; }
QPushButton#setVal { background: {glass}; color: {mut}; border: 1px solid {line};
  border-radius: 8px; padding: 5px 12px; font-size: 12px; }
QPushButton#setVal:hover { color: {acc}; border-color: {acc_line}; }
QPushButton#segBtn { background: transparent; color: {mut}; border: none;
  border-radius: 7px; padding: 5px 14px; font-size: 12px; font-weight: 600; }
QPushButton#segBtn[sel="on"] { background: {acc_soft}; color: {acc}; }
QPushButton#segBtn:hover { color: {acc}; }
QSlider#setSlider:disabled::handle:horizontal { background: {dim}; }
QSlider#setSlider:disabled::groove:horizontal { background: {line}; }
QSlider#setSlider::groove:horizontal { background: {line}; height: 6px; border-radius: 3px; }
QSlider#setSlider::handle:horizontal { background: {acc}; width: 16px; margin: -5px 0; border-radius: 8px; }


/* ── 账户 ────────────────────────────────── */
QWidget#page-account { background: {board}; }
QFrame[card="account"] { background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
  stop:0 rgba(56,189,248,0.16), stop:1 rgba(37,99,235,0.16));
  border: 1px solid {acc_line}; border-radius: {radius}; }
QLabel#accName { color: {tx}; font-size: 18px; font-weight: 800; }
QLabel#accRole { color: {acc}; font-size: 12px; font-weight: 600; }
QLabel#accMeta { color: {mut}; font-size: 12px; }
QLabel#panelTitle { color: {tx}; font-size: 16px; font-weight: 800; }
QLabel#AvatarBig { background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
  stop:0 {ok_grad0}, stop:1 {ok_grad1}); color: #FFFFFF; border-radius: 32px;
  font-size: 22px; font-weight: 800; }
QLabel#accMetaK { color: {mut}; font-size: 12.5px; }
QLabel#accMetaV { color: {tx}; font-size: 13.5px; font-weight: 600; }
QFrame[card="acc-line"] { background: transparent; border: none;
  border-bottom: 1px solid {line}; }
QFrame[card="acc-line-end"] { background: transparent; border: none; }
QFrame[card="stat"] { background: {glass}; border: 1px solid {line}; border-radius: 11px; }
QLabel#statK { color: {dim}; font-size: 11px; }
QLabel#statV { color: {tx}; font-size: 15px; font-weight: 800; }
QLabel#statV[st="ok"] { color: {ok}; }
/* 统计卡（行式，对齐设计稿 .account-stat） */
QFrame[card="stat-panel"] { background: {glass}; border: 1px solid {line}; border-radius: {radius}; }
QLabel#statRK { color: {dim}; font-size: 12px; }
QLabel#statRV { color: {tx}; font-size: 13px; font-weight: 600; }
QLabel#statRV[st="ok"] { color: {ok}; }


/* ── 远程协助 ────────────────────────────── */
QWidget#page-remote, QWidget#page-remote-ctrl, QWidget#page-remote-invite { background: {board}; }
QFrame[card="remote-tile"] { background: {glass}; border: 1px solid {line}; border-radius: {radius}; }
QFrame[card="remote-tile"]:hover { border-color: {acc}; background: {acc_soft}; }
QLabel#rtName { color: {tx}; font-size: 15px; font-weight: 700; }
QLabel#rtDesc { color: {dim}; font-size: 12px; }
QLabel#rtStep { color: {mut}; font-size: 12px; }
QLabel#rtStep b { color: {acc}; }
QFrame#keypad QPushButton { background: {glass}; color: {tx}; border: 1px solid {line};
  border-radius: 12px; font-size: 18px; font-weight: 700; }
QFrame#keypad QPushButton:hover { border-color: {acc}; color: {acc}; }
QLabel#remoteBigId { color: {tx}; font-size: 28px; font-weight: 800; letter-spacing: 3px;
  font-family: "JetBrains Mono", Consolas, monospace; }
QLineEdit#remoteIdInput { background: {input_bg}; color: {tx}; border: 1px solid {line};
  border-radius: 8px; padding: 10px 14px; font-size: 16px; font-weight: 700;
  font-family: "JetBrains Mono", Consolas, monospace; letter-spacing: 2px; }
QLineEdit#remoteIdInput:focus { border-color: {acc}; }
QFrame[card="notes"] { background: {warn_soft}; border: 1px solid {warn_line}; border-radius: 10px; }
QLabel#notesTitle { color: {warn}; font-size: 13px; font-weight: 700; }
QLabel#notesBody { color: {dim}; font-size: 12.5px; }


/* ── 骨架占位页（专用诊断 / 高级功能 / EBS / CAN / 更新） ── */
QFrame[card="grid5"], QFrame[card="grid4"] { background: {glass}; border: 1px solid {line};
  border-radius: {radius}; }
QFrame[card="grid5"]:hover, QFrame[card="grid4"]:hover { border-color: {acc_line}; }
QLabel#gridName { color: {tx}; font-size: 14px; font-weight: 700; }
QLabel#gridSub { color: {dim}; font-size: 11px; }
/* 设计稿 .seq 序号徽章：渐变圆角块 + 白字（grid/list/func/match 通用） */
QLabel#gridSeq, QLabel#listSeq, QLabel#funcSeq, QLabel#matchSeq {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
    stop:0 {acc_grad0}, stop:1 {acc_grad1});
  color: {acc_ink}; font-size: 11px; font-weight: 800;
  font-family: "JetBrains Mono", Consolas, monospace; }
QLabel#gridSeq { border-radius: 7px; }
QLabel#matchSeq { border-radius: 7px; }
QLabel#listSeq { border-radius: 9px; }
QLabel#funcSeq { border-radius: 11px; }
QFrame#listRow { background: {glass}; border: 1px solid {line}; border-radius: 10px; }
QFrame#listRow:hover { border-color: {acc_line}; }
QLabel#listName { color: {tx}; font-size: 13px; font-weight: 600; }
QPushButton#listGo { background: transparent; color: {dim}; border: none; font-size: 15px; }
QPushButton#listGo:hover { color: {acc}; }
QLabel#listSub { color: {dim}; font-size: 11px; }
QFrame#funcRow { background: {glass}; border: 1px solid {line}; border-radius: 10px; }
QFrame#funcRow:hover { border-color: {acc}; }
QLabel#funcName { color: {tx}; font-size: 13px; font-weight: 700; }
QLabel#funcDesc { color: {dim}; font-size: 11px; }
QFrame#ecRow { background: {glass}; border: 1px solid {line}; border-radius: 8px; }
QFrame#ecRow:hover { border-color: {acc_line}; }
QLabel#ecKey { color: {tx}; font-size: 12px; }
QLabel#ecVal { color: {mut}; font-size: 12px; }
QLabel#ecTag { border-radius: 8px; padding: 1px 9px; font-size: 10px; font-weight: 700; }
QLabel#ecTag[st="cur"] { background: {crit_soft}; color: {crit}; }
QLabel#ecTag[st="ok"] { background: {ok_soft}; color: {ok}; }
QLabel#ecTag[st="warn"] { background: {warn_soft}; color: {warn}; }
QFrame#matchGroup { background: {glass}; border: 1px solid {line}; border-radius: 11px; }
QLabel#matchTitle { color: {tx}; font-size: 13px; font-weight: 700; }
QFrame#matchLine { background: {line}; }
QComboBox#matchCombo { background: {input_bg}; color: {tx}; border: 1px solid {line};
  border-radius: 8px; padding: 4px 10px; font-size: 12px; min-width: 130px; }
QComboBox#matchCombo:hover { border-color: {acc_line}; }
QComboBox#matchCombo::drop-down { border: none; width: 22px; }
QComboBox#matchCombo QAbstractItemView { background: {panel}; color: {tx};
  border: 1px solid {line}; selection-background-color: {acc_soft};
  selection-color: {tx}; outline: none; }
QRadioButton#matchRadio { color: {mut}; font-size: 12px; spacing: 5px; }
QRadioButton#matchRadio::indicator { width: 14px; height: 14px; border-radius: 7px;
  border: 1px solid {line}; background: transparent; }
QRadioButton#matchRadio::indicator:checked { border: 4px solid {acc}; background: {panel}; }
QLineEdit#matchInput { background: {input_bg}; color: {tx}; border: 1px solid {line};
  border-radius: 8px; padding: 4px 10px; font-size: 12px; min-width: 130px; }
QLineEdit#matchInput:focus { border-color: {acc}; }
QFrame#updRow { background: {glass}; border: 1px solid {line}; border-radius: 11px; }
QLabel#updName { color: {tx}; font-size: 14px; font-weight: 700; }
QLabel#updK { color: {dim}; font-size: 11px; }
QLabel#updV { color: {mut}; font-size: 12px; }
QLabel#updV[new="on"] { color: {warn}; font-weight: 700; }
QLabel#updV[link="on"] { color: {acc}; }
